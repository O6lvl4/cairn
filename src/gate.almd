// The write gate: no file lands on disk unless it still parses.
//
//   1. a configured command — `AGENT_CHECK_<EXT>="ruff check {}"`
//      (FAMULUS5_CHECK_<EXT> / FAMULUS4_CHECK_<EXT> honoured too)
//   2. a built-in syntax-only command the language ships (never a
//      compiler: `rustc` on one file of a project fails on `use crate::…`)
//      — gramide for Almide and Go when it is on PATH, else the toolchain's
//   3. otherwise the write proceeds and says it was unchecked.
//
// A write goes to a same-directory temp file that keeps the real extension
// (`node --check` refuses a `.tmp`), is checked there, and is renamed into
// place only if it passes. A refused write leaves the original untouched.

import fs
import env
import process
import self.observe

type Checker = { label: String, program: String, args: List[String] }   // `{}` is the file path; label "" = none

// Never a compiler: `rustc` on one file of a project fails on `use crate::…`
// and would refuse correct edits. `rustfmt --emit stdout` is the exception
// that is not one — it parses and never resolves, so it takes a file with
// unresolved imports (exit 0) and refuses an unclosed delimiter (exit 1).
// Java and C++ have no such tool and are left ungated, said out loud.
let BUILTIN = [
  ("rs", "rust", "rustfmt", ["--emit", "stdout", "--edition", "2021", "{}"]),
  ("py", "python", "python3", ["-m", "py_compile", "{}"]),
  ("pyi", "python", "python3", ["-m", "py_compile", "{}"]),
  ("rb", "ruby", "ruby", ["-c", "{}"]),
  ("sh", "shell", "bash", ["-n", "{}"]),
  ("bash", "shell", "bash", ["-n", "{}"]),
  ("go", "go", "gofmt", ["-e", "{}"]),
  ("php", "php", "php", ["-l", "{}"]),
  ("lua", "lua", "luac", ["-p", "{}"]),
  ("js", "javascript", "node", ["--check", "{}"]),
  ("mjs", "javascript", "node", ["--check", "{}"]),
  ("cjs", "javascript", "node", ["--check", "{}"]),
  ("almd", "almide", "almide", ["check", "{}"]),
  ("json", "json", "python3", ["-c", "import json,sys; json.load(open(sys.argv[1]))", "{}"]),
  ("toml", "toml", "python3", ["-c", "import tomllib,sys; tomllib.load(open(sys.argv[1],'rb'))", "{}"]),
]

let NONE = Checker { label: "", program: "", args: [] }

effect fn on_path(bin: String) -> Bool = (observe.run("command -v " + bin, ".", 5000)!).code == 0

// `AGENT_CHECK_PY="ruff check {}"` overrides the built-in for `.py`.
effect fn configured(ext: String) -> Checker? = {
  let key = string.to_upper(ext)
  let raw = string.trim(env.get("AGENT_CHECK_" + key) ?? env.get("FAMULUS5_CHECK_" + key) ?? env.get("FAMULUS4_CHECK_" + key) ?? "")
  if raw == "" then none
  else {
    let parts = list.filter(string.split(raw, " "), (p) => p != "")
    let program = list.first(parts) ?? raw
    var args = list.drop(parts, 1)
    if not list.contains(args, "{}") then list.push(args, "{}") else ()
    some(Checker { label: program, program: program, args: args })
  }
}

// Which check this path gets, in tier order; none is said, not assumed.
effect fn checker_for(path: String) -> Checker = {
  let ext = observe.extension_of(path)
  if ext == "" then NONE
  else match configured(ext)! {
    some(c) => c,
    none =>
      if (ext == "almd" or ext == "go") and on_path("gramide")! then Checker { label: "gramide", program: "gramide", args: ["check", "{}"] }
      else match list.find(BUILTIN, (b) => b.0 == ext) {
        some((_, label, program, args)) => Checker { label: label, program: program, args: args },
        none => NONE,
      },
  }
}

type Verdict = { kind: String, why: String }   // ok | invalid | unavailable

effect fn run_checker(c: Checker, tmp: String) -> Verdict =
  if c.label == "" then Verdict { kind: "ok", why: "" }
  else {
    let args = list.map(c.args, (a) => if a == "{}" then tmp else a)
    match process.exec_status_timeout(c.program, args, 30000) {
      // ask PATH, do not read the error text: a checker that exists and crashed
      // is a different fact from one that is not installed (ADR-0004)
      err(e) => if on_path(c.program)! then Verdict { kind: "invalid", why: e } else Verdict { kind: "unavailable", why: "" },
      ok(st) => if st.code == 0 then Verdict { kind: "ok", why: "" }
        else {
          let msg = string.trim(string.replace(st.stdout + st.stderr, tmp, "<file>"))
          Verdict { kind: "invalid", why: if msg == "" then c.program + ": exit " + int.to_string(st.code) else msg }
        },
    }
  }

type Written = { path: String, bytes: Int, checked: String }   // checked "" = unchecked

// Write `source` to `path` if it passes its checker; an error beginning
// `edit.write:` otherwise, with the original untouched.
effect fn write_checked(path: String, source: String, create: Bool) -> Result[Written, String] =
  if not create and not fs.exists(path) then err("edit.write: " + path + " does not exist (use create to make a new file)")
  else write_gated(path, source)

effect fn write_gated(path: String, source: String) -> Result[Written, String] = {
  let c = checker_for(path)!
  let dir = match string.last_index_of(path, "/") { some(i) => string.take(path, i), none => "." }
  let name = list.last(string.split(path, "/")) ?? path
  let ext = observe.extension_of(path)
  let tmp = dir + "/." + name + ".agent.tmp" + (if ext == "" then "" else "." + ext)
  fs.write(tmp, source) |> result.map_err((e) => "edit.write: " + e)!
  let v = run_checker(c, tmp)!
  if v.kind == "invalid" then { let _ = fs.remove(tmp); err("edit.write: " + v.why) }
  else {
    fs.rename(tmp, path) |> result.map_err((e) => "edit.write: rename: " + e)!
    ok(Written { path: path, bytes: list.len(string.to_bytes(source)), checked: if v.kind == "ok" and c.label != "" then c.label else "" })
  }
}

test "the gate covers the languages it claims to" {
  // (checker_for is an effect fn; this asserts the table it reads)
  assert(list.any(BUILTIN, (b) => b.0 == "rs" and b.2 == "rustfmt"))
  assert(list.any(BUILTIN, (b) => b.0 == "py"))
  assert(not list.any(BUILTIN, (b) => b.0 == "java" or b.0 == "cpp"))
}

test "configured checker parsing adds the placeholder" {
  assert_eq(observe.extension_of("a/b.Py"), "py")
  assert_eq(observe.extension_of("Makefile"), "")
}
